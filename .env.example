# ==============================================================================
# GestãoFut App - Environment Variables
#
# Only truly PUBLIC configuration may use the EXPO_PUBLIC_ prefix — it gets
# bundled into the client binary and is readable by anyone. Never put
# secrets, API keys, or credentials here (see src/services/api/env.ts).
#
# Copy this file to .env.development / .env.production (or .env for local
# work) and adjust per environment. See docs/development.md.
# ==============================================================================

# Origin of the gestaofut-api server (no trailing slash, no path).
# The API client appends /api/v1 for versioned endpoints internally.
EXPO_PUBLIC_API_URL=http://localhost:3000
